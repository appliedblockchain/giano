# giano-devnet — anvil pre-loaded with a baked state (EntryPoint v0.7 + Giano factory +
# implementation + testing paymaster/ERC20 at their CREATE2 addresses). Instant-boot
# deterministic local chain replacing hh:node / hh:initlocal / aa:deploy:local.
#   docker build -f services/devnet/Dockerfile -t ghcr.io/appliedblockchain/giano-devnet .
# The state is generated by e2e/devnet (setup-entrypoint.mjs + ignition deploy + dump).
FROM ghcr.io/foundry-rs/foundry@sha256:8347b728d5d393dac1c018691b36f506d23b9dcd78341d40ea0fcb11c3a19cdd
COPY e2e/devnet/state.json /devnet/state.json
COPY e2e/devnet/addresses.json /devnet/addresses.json
EXPOSE 8545
ENTRYPOINT ["anvil"]
CMD ["--host", "0.0.0.0", "--chain-id", "31337", "--load-state", "/devnet/state.json"]
