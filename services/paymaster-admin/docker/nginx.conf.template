# The standalone RPC proxy's shared rate limit, rendered by the entrypoint only when that proxy is.
${GIANO_RPC_LIMIT_ZONE}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # A location with an add_header of its own would otherwise drop every header set here — which
    # is how /config.json and /assets/ used to go out with no CSP. Merged, each location adds its
    # Cache-Control to these instead of replacing them.
    add_header_inherit merge;

    # An operator console has no business being framed, and nothing here is meant to be embedded.
    add_header X-Frame-Options "DENY" always;
    # 'unsafe-inline' for styles is Emotion's runtime style injection, which Chakra is built on.
    # Everything else is self-hosted — no external fonts, no CDN — so this console works unchanged
    # in an air-gapped deployment.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${GIANO_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Same-origin RPC proxies, one per chain, generated by the entrypoint so that no provider
    # key reaches the browser — only for a standalone console: with GIANO_WALLET_API_UPSTREAM set
    # there are none, and the console reads through wallet-api's platform relay under /api/.
    # Generated rather than written here because a template cannot loop over the chain list. Each
    # carries a literal upstream, resolved once at config load. After them, only when the upstream
    # is set, the platform API proxy to wallet-api and its resolver — rendered by the entrypoint,
    # which says why it looks the way it does.
${GIANO_RPC_LOCATIONS}${GIANO_API_LOCATION}

    location = /config.json {
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
