server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # An operator console has no business being framed, and nothing here is meant to be embedded.
    add_header X-Frame-Options "DENY" always;
    # 'unsafe-inline' for styles is Emotion's runtime style injection, which Chakra is built on.
    # Everything else is self-hosted — no external fonts, no CDN — so this console works unchanged
    # in an air-gapped deployment.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${GIANO_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Same-origin RPC proxy, so the console works against a node that sets no CORS headers
    # (anvil in the e2e stack). Point rpcUrl at /rpc to use it.
    location = /rpc {
        proxy_pass ${GIANO_RPC_UPSTREAM}/;
        proxy_set_header Host $host;
    }

    location = /config.json {
        add_header Cache-Control "no-store" always;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
