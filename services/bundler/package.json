{
	"name": "@appliedblockchain/giano-bundler",
	"version": "0.1.0",
	"private": true,
	"description": "Giano's ERC-4337 submission service: estimates, simulates and submits each UserOperation as its own handleOps transaction",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"generate": "node scripts/generate-simulations.mjs",
		"generate:check": "node scripts/generate-simulations.mjs --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@appliedblockchain/giano-contracts": "workspace:^",
		"pino": "^9.6.0",
		"prom-client": "^15.1.3",
		"viem": "2.31.6",
		"zod": "3.24.4"
	},
	"devDependencies": {
		"@account-abstraction/contracts": "0.7.0",
		"@types/node": "^22.7.5",
		"pino-pretty": "^13.0.0",
		"tsdown": "0.23.1",
		"tsx": "^4.19.4",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	},
	"files": [
		"dist"
	]
}
