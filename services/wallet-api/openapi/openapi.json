{
  "openapi": "3.1.0",
  "info": {
    "title": "Giano Wallet API",
    "description": "WebAuthn ceremonies, sessions and policied ERC-4337 user-operation relay for Giano smart wallets (multi-tenant).",
    "version": "1.0.0"
  },
