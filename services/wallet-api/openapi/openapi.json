                    "userOperationHash": {
                      "type": "string"
                    },
                    "duplicate": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "userOperationHash"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
