    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque session token from a ceremony verify endpoint"
      },
      "adminKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-tenant admin API key (provisioned via TENANTS_SEED)"
      }
    },
    "schemas": {}
  },
