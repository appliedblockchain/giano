{
	"name": "@appliedblockchain/giano-wallet-api",
	"version": "0.1.0",
	"private": true,
	"description": "Giano wallet backend: WebAuthn ceremonies, sessions and policied UserOperation relay",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"migrate": "tsx src/migrate.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify:authorisation": "tsx scripts/verify-authorisation.ts",
		"platform:login": "tsx scripts/platform-login.ts",
		"openapi": "tsx openapi/generate.ts",
		"openapi:check": "tsx openapi/generate.ts --check"
	},
	"dependencies": {
		"@appliedblockchain/giano-contracts": "workspace:^4.0.0",
		"@appliedblockchain/giano-tx-describe": "workspace:^4.0.0",
		"@fastify/cors": "10.1.0",
		"@fastify/rate-limit": "10.3.0",
		"@fastify/swagger": "9.8.1",
		"@fastify/swagger-ui": "6.1.2",
		"@simplewebauthn/server": "13.3.2",
		"drizzle-orm": "0.45.4",
		"fastify": "5.12.7",
		"fastify-plugin": "5.1.0",
		"fastify-type-provider-zod": "4.0.2",
		"pg": "8.22.0",
		"pino": "9.7.0",
		"prom-client": "15.1.3",
		"viem": "2.57.10",
		"zod": "3.24.4"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "10.28.0",
		"@types/node": "22.7.5",
		"@types/pg": "8.20.0",
		"pino-pretty": "13.1.3",
		"tsdown": "0.23.1",
		"tsx": "4.19.4",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"files": [
		"dist",
		"migrations",
		"openapi/openapi.json"
	]
}
