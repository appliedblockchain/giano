{
  "name": "@appliedblockchain/giano-wallet-api",
  "version": "0.1.0",
  "private": true,
  "description": "Giano wallet backend: WebAuthn ceremonies, sessions and policied UserOperation relay",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx openapi/generate.ts",
    "openapi:check": "tsx openapi/generate.ts --check"
  },
  "dependencies": {
    "@appliedblockchain/giano-contracts": "workspace:^",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@simplewebauthn/server": "^13.1.1",
    "drizzle-orm": "^0.43.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "viem": "2.31.6",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.24.2",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.4",
    "typescript": "5.5.4",
    "vitest": "^3.1.2"
  },
  "files": [
    "dist",
    "migrations",
    "openapi/openapi.json"
  ]
}
