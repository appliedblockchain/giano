# `pnpm dev` defaults — the SAME names the container reads at start (docker/entrypoint.sh), so a
# developer's env file and a deployment's environment are one document. Vite loads this file in
# development; put personal overrides in `.env.local` (git-ignored), never here.
#
# Defaults below target the local e2e stack (deploy/docker-compose.e2e.yml) through the names
# portless serves (e2e/origins.mjs). Bring the stack and the names up first:
#   docker compose --profile portless -f deploy/docker-compose.e2e.yml up --build
#   pnpm -F @appliedblockchain/giano-e2e portless:up
# then `pnpm demo:stock` (http://demo.localhost) or `pnpm demo:byo` (http://demo-byo.localhost).

# The TENANT's wallet origin. Each dApp is pinned to exactly one.
GIANO_WALLET_URL=http://wallet.localhost

# Optional: a wallet origin that does NOT allow-list this dApp — enables the "disallowed origin"
# control in the failure lab (expects HandshakeRefusedError origin-not-allowed).
GIANO_OTHER_WALLET_URL=http://wallet-byo.localhost

# Optional free-text tag beside the title.
GIANO_APP_LABEL=tenant: stock

# The chains the demo can address, as a JSON array. `rpcUrl` is browser-facing; on a real chain prefer
# a public endpoint or the container's same-origin proxy (`/rpc/<chainId>` + GIANO_RPC_UPSTREAM_<chainId>).
# `defaultToken` prefills the ERC-20 card — Giano's test token, at its CREATE2 address.
GIANO_CHAINS=[{"chainId":31337,"name":"Devnet A","rpcUrl":"http://rpc.localhost","defaultToken":"0x9967bDf929856643e92EF65eefdE1fF8250774D8"},{"chainId":31338,"name":"Devnet B","rpcUrl":"http://rpc-b.localhost","defaultToken":"0x9967bDf929856643e92EF65eefdE1fF8250774D8"}]
