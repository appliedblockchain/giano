server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The demo dApp is not meant to be embedded, and framing it would put a wallet handshake
    # inside someone else's page.
    # NOTE what is deliberately NOT here: Cross-Origin-Opener-Policy. The connector opens the
    # wallet origin in a popup and talks to it over postMessage, which needs `window.opener`.
    # A COOP header of `same-origin` severs that reference and the connect handshake times out.
    # The demo's preflight card detects that header on its own page and says so.
    #
    # connect-src carries THREE kinds of origin, and the third is the one that gets forgotten
    # until a sponsored transaction hangs:
    #   1. the chain RPC(s)   — balances, metadata and allowances are read dApp-side
    #   2. 'self'             — /config.js, the assets and any /rpc/<chainId> proxy
    #   3. the WALLET origin  — the thin connector polls `${walletUrl}/api/v1/userops/<hash>/receipt`
    #                           and the preflight fetches `${walletUrl}/api/v1/version` from THIS
    #                           origin, so the wallet origin is a cross-origin fetch target, not just
    #                           a postMessage peer. The tenant's `corsOrigins` must name this dApp
    #                           origin for the same reason, from the other side.
    # entrypoint.sh composes all of it into GIANO_CSP_CONNECT_SRC.
    #
    # 'unsafe-inline' for styles is Emotion's runtime style injection, which Chakra is built on.
    # No font origins: the theme uses the system font stack.
    #
    # nginx gotcha, load-bearing: `add_header` inside a `location` REPLACES the server-level set,
    # so every location below that adds a Cache-Control header restates these four. Drop one copy
    # and that response silently loses its CSP — which is exactly the kind of thing the demo's
    # preflight cannot see from the browser.
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' ${GIANO_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Same-origin RPC proxies, one per chain with GIANO_RPC_UPSTREAM_<chainId> set (entrypoint.sh).
    # Unused by default: config.js points each rpcUrl straight at a public endpoint. Set a chain's
    # rpcUrl to `/rpc/<chainId>` and GIANO_RPC_UPSTREAM_<chainId> to the keyed URL to use this
    # instead — the key stays server-side (R17).
    ${GIANO_RPC_LOCATIONS}

    # Runtime config: never cached, or a redeploy serves the previous environment's wallet origin
    # to anyone holding a warm cache.
    location = /config.js {
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' ${GIANO_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # Hashed assets are immutable; the HTML shell that names them must never be cached (a stale
    # index.html would reference assets that no longer exist after a deploy).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' ${GIANO_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location / {
        expires epoch;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' ${GIANO_CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri $uri/ /index.html;
    }
}
