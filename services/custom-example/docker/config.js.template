// Rendered at container start by docker/entrypoint.sh. One published image serves every deployment
// (R16), so nothing about which chains, which wallet origin or which label this dApp uses is baked in
// at build time. The same GIANO_* names drive `pnpm dev` through .env.development / .env.local.
//
// A plain <script> rather than a fetched /config.json, deliberately: src/config.ts reads this
// synchronously so the page can decide, before any provider exists, whether the configuration is
// usable (a configuration-error screen otherwise). index.html loads this file ahead of the bundle.
//
// `chains` is emitted as a JSON literal — the entrypoint checks it is a JSON array; the browser
// (src/config.ts, zod) validates every field and names the ones that are wrong.
window.__GIANO_CONFIG__ = {
  // The TENANT's wallet origin, and each dApp is pinned to exactly one of them.
  walletUrl: '${GIANO_WALLET_URL}',
  // Optional: a wallet origin that does NOT allow-list this dApp (failure lab, origin-not-allowed).
  otherWalletUrl: '${GIANO_OTHER_WALLET_URL}',
  // Empty strings are treated as unset by src/config.ts.
  appLabel: '${GIANO_APP_LABEL}',
  chains: ${GIANO_CHAINS},
};
