{
	"name": "@appliedblockchain/giano-example",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"description": "Giano reference dApp: the thin two-origin SDK, every method reachable, every outcome recorded. Vite + React + Chakra UI.",
	"scripts": {
		"dev": "vite --host --port 4410 --strictPort",
		"dev:stock": "env GIANO_WALLET_URL=http://wallet.localhost GIANO_OTHER_WALLET_URL=http://wallet-byo.localhost GIANO_APP_LABEL='tenant: stock' vite --host --port 4410 --strictPort",
		"dev:byo": "env GIANO_WALLET_URL=http://wallet-byo.localhost GIANO_OTHER_WALLET_URL=http://wallet.localhost GIANO_APP_LABEL='tenant: byo' vite --host --port 4411 --strictPort",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"build": "pnpm lint && tsc --noEmit && vite build && node scripts/scan-bundle.mjs",
		"preview": "vite preview --port 4410"
	},
	"dependencies": {
		"@appliedblockchain/giano-connector": "4.0.0",
		"@chakra-ui/react": "3.36.1",
		"@emotion/react": "11.14.0",
		"@rainbow-me/rainbowkit": "2.2.5",
		"@tanstack/react-query": "5.76.1",
		"next-themes": "0.4.6",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-icons": "5.7.0",
		"viem": "2.57.10",
		"wagmi": "2.15.6",
		"zod": "3.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "20.17.48",
		"@types/react": "19.1.4",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.7.0",
		"typescript": "7.0.2",
		"vite": "6.4.3"
	},
	"packageManager": "pnpm@11.15.1+sha256.27460629b10111604e7f98882753b53398986820c20e0a065f3a4a5e9e7db71f"
}
