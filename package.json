{
	"name": "@appliedblockchain/giano",
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"demo:dev": "pnpm -C services/custom-example dev",
		"demo:stock": "pnpm -C services/custom-example dev:stock",
		"demo:byo": "pnpm -C services/custom-example dev:byo",
		"demo:admin": "pnpm -F @appliedblockchain/giano-paymaster-admin dev",
		"paymaster": "pnpm --filter @appliedblockchain/giano-paymaster-sdk run cli --",
		"paymaster:demo": "pnpm --filter @appliedblockchain/giano-paymaster-sdk run demo --",
		"build:connector": "pnpm -F @appliedblockchain/giano-connector build",
		"git:init": "git submodule update --init --recursive",
		"local:node": "pnpm --filter @appliedblockchain/giano-contracts local:node",
		"local:deploy": "pnpm --filter @appliedblockchain/giano-contracts local:deploy",
		"doctor": "pnpm --filter @appliedblockchain/giano-contracts run doctor --",
		"contracts:deploy": "bash deploy/contracts/run.sh deploy",
		"contracts:funding": "bash deploy/contracts/run.sh funding",
		"contracts:provision": "bash deploy/contracts/run.sh provision",
		"contracts:sponsorship": "bash deploy/contracts/run.sh sponsorship",
		"contracts:doctor": "bash deploy/contracts/run.sh doctor",
		"contracts:timelock": "bash deploy/contracts/run.sh timelock",
		"contracts:handoff": "bash deploy/contracts/run.sh handoff",
		"contracts:rehearse": "bash deploy/contracts/run.sh rehearse"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "2.31.1",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	},
	"packageManager": "pnpm@12.17.0+sha256.6d776e285187f9e334d8826cc5a88e82e41606345f196a5a93f4403bd332553e"
}
