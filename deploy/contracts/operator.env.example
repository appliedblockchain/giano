# Copy to deploy/contracts/<chain>.local.env; never put secrets in this committed example.
# Public network identity, release, admin, fees and gas reserve live in deploy/chains/<chain>.json.
# Use that profile's rpcUrlEnv variable for a keyed endpoint (or DEPLOY_RPC_URL for a one-off override).
# Examples: BASE_SEPOLIA_RPC_URL, ETHEREUM_SEPOLIA_RPC_URL. Leave them unset to use the public fallback.

# The canonical deployer key (CANONICAL_DEPLOYER_PRIVATE_KEY) never goes in this or any file: load it
# from the class's 1Password item into the deploying shell's environment only (docs/key-ceremony.md).
# Separate EOA operator key: must hold ROLE_ADMIN for the EOA provisioning workflow.
DEPLOYER_PRIVATE_KEY=
# wallet-api's ERC-7677 sponsorship signer, by ADDRESS: provisioning registers it on-chain. In
# production its key lives in the HSM and never leaves it. The local demo stack
# (docker-compose.chain.yml) still reads SPONSORSHIP_SIGNER_KEY to sign with; a testnet may set both.
SPONSORSHIP_SIGNER_ADDRESS=
SPONSORSHIP_SIGNER_KEY=
BUNDLER_EXECUTOR_PRIVATE_KEYS=

# Who holds each immediate paymaster role after provisioning (docs/PAYMASTER-TIMELOCK-RUNBOOK.md §1).
# The timelocked roles (ROLE_ADMIN, upgrader, fee admin, withdraw-address admin) go to the timelock
# with contracts:handoff instead.
ROLE_HOLDER_SIGNER_ADMIN=
ROLE_HOLDER_PARAM_ADMIN=
ROLE_HOLDER_PAUSER=
ROLE_HOLDER_STAKE_ADMIN=
ROLE_HOLDER_TENANT_ADMIN=
ROLE_HOLDER_FEE_COLLECTOR=
# Development only, refused on a mainnet: every role on this one address instead of the holders above.
PAYMASTER_GRANT_ALL_TO=

# Provisioning: each invocation ADDS this amount to EACH tenant, not a target balance.
STAKE_ETH=0.1
UNSTAKE_DELAY=86400
TENANT_FUND_ETH=0.02
TENANT_WITHDRAW_ADDRESS=
# Explicit slug:existing-database-uuid pairs. Never invent replacement IDs for existing tenants.
# For the current development environment, preserve the IDs in deploy/infrastructure.aws.env.example.
PAYMASTER_TENANTS=

# Optional external-chain local demo. Fill in the real tenant UUID, matching a pair above.
TENANT_SLUG=example
TENANT_ID=
ADMIN_API_KEY=
# contracts:sponsorship: the tenant's contracts to sponsor, comma-separated, every function allowed.
# Required on a chain without the demo ERC-20 (every public chain): the wallet-api sponsors nothing,
# not even wallet management, for a tenant whose allowlist is empty.
SPONSOR_ALLOWLIST=
WALLET_ORIGIN=http://wallet.localhost:8081
WALLET_API_URL=http://wallet.localhost:8081/api
RP_ID=wallet.localhost
RP_NAME="Giano Example"
BRAND_NAME="Giano Example"
GIANO_ALLOWED_DAPP_ORIGINS=["http://app.localhost:4400","http://localhost:4400","http://127.0.0.1:4400"]
TENANT_CORS_ORIGINS=["http://app.localhost:4400","http://localhost:4400","http://127.0.0.1:4400"]
OPEN_REGISTRATION=true
LOG_LEVEL=info
# Bearer token for wallet-api GET /metrics, at least 16 characters (e.g. `openssl rand -hex 24`).
METRICS_BEARER_TOKEN=
# Historical application environment name; selects the existing local demo admin bootstrap.
# It is independent of the selected chain, and changing it affects platform-admin seeding.
GIANO_ENVIRONMENT=local-sepolia
# For Compose only, provide RPC_URL and optionally BUNDLER_NODE_RPC_URL (backend URLs).
# CHAIN_ID, CHAIN_NAME and addresses come from <chainId>.addresses.env after deployment.
