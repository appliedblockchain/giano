# Giano — Ethereum Sepolia contract deployment + local demo stack.
#   cp deploy/sepolia.env.example deploy/.env   then fill in the values below.
#
# ⚠ NEVER put real keys in THIS file. `deploy/sepolia.env.example` is committed to the repo;
# only `deploy/.env` is gitignored (`**/.env`). Every value here is a placeholder.
#
# The file has two halves and they are independent:
#
#   A. CONTRACT DEPLOYMENT — deploying and provisioning Giano on Sepolia. Used by the scripts
#      in deploy/sepolia/. These values are aligned with the development environment described
#      in infra/, because the contracts and paymaster this deploys are what that environment
#      consumes. Only ONE RPC is needed here, and only for deployment.
#
#   B. LOCAL DEMO STACK — docker-compose.sepolia.yml, a single-tenant stack on *.localhost for
#      exercising the deployment from a browser. Nothing in infra/ depends on it.

# ==========================================================================================
# A. CONTRACT DEPLOYMENT
# ==========================================================================================

# ── Chain ─────────────────────────────────────────────────────────────────────────────────
CHAIN_ID=11155111
# For deploying to a chain other than Sepolia with `--network custom`, also set:
# DEPLOY_CHAIN_ID=11155111

# Canonical ERC-4337 EntryPoint v0.7. The wallet implementation HARDCODES this address, so a
# chain carrying a different EntryPoint produces different bytecode and different addresses for
# everything downstream (specs/CHAIN-ADOPTION.md step 2). Override only if you know why.
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ── Deployment RPC ────────────────────────────────────────────────────────────────────────
# The only RPC the deployment needs. Any Sepolia endpoint works — it serves eth_call,
# eth_sendRawTransaction and receipts, nothing exotic. Prefer a keyed endpoint over a public
# one: a dropped receipt mid-run is what corrupts the Ignition journal, not a missing method.
#
# This is NOT the environment's serving RPC. What the deployed environment reads and bundles
# through is configured in infra/ and reaches the containers from Secrets Manager; nothing
# here feeds it.
DEPLOY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Deployer key  (testnet only — never reuse a real key) ⚠️ FUND THIS ─────────────────────
# Deploys every contract and pays for provisioning: the paymaster stake, each tenant's funded
# balance, and the test paymaster's deposit. ~0.15 Sepolia ETH covers all of it.
# ./deploy/sepolia/print-funding.sh prints the address and balance.
DEPLOYER_PRIVATE_KEY=

# The key wallet-api signs ERC-7677 sponsorships with. Needs NO funding — it authorises
# spending against a tenant's balance on the paymaster and never pays gas. Registered as an
# authorised signer by provision-paymaster.sh, so changing it means re-running that script.
# In the deployed environment this is [ASM] giano-<env>-sponsorship-signer-key; the value here
# only has to match if you intend this deployment to serve that environment.
SPONSORSHIP_SIGNER_KEY=

# ── Contract addresses — written back by deploy/sepolia/deploy-contracts.sh ────────────────
# All five are CREATE2 addresses and must equal the frozen constants in
# packages/contracts/canonical.ts. The script asserts that and aborts on divergence.
FACTORY_ADDRESS=
# The production GianoPaymaster proxy — what sponsorship runs through. This is the address
# infra/iac/ecs_services.vars.tf pins as `paymaster_address`.
SPONSORSHIP_PAYMASTER_ADDRESS=
# The permissive test paymaster. A separate variable on purpose: neither may ever be passed
# where the other is meant. The deployed environment does not use it.
TEST_PAYMASTER_ADDRESS=
TEST_ERC20_ADDRESS=

# Which paymasters wallet-api will relay a sponsored op through. Defaults to
# SPONSORSHIP_PAYMASTER_ADDRESS, which is what you want; empty would allow ANY paymaster.
# USEROP_ALLOWED_PAYMASTERS=

# Seeds the TEST paymaster's EntryPoint deposit at deploy time. The production paymaster is
# funded by provision-paymaster.sh instead. Set SKIP_TESTING=1 on the deploy script to omit
# the test fixtures entirely, which is what Base Sepolia carries today.
PAYMASTER_FUND_ETH=0.01

# ── Paymaster provisioning — deploy/sepolia/provision-paymaster.sh ─────────────────────────
# Spent from the deployer.
#
# STAKE_ETH must be >= 0.1. That is MIN_STAKE_WEI in packages/contracts/scripts/doctor.ts, and
# the doctor FAILS below it — an under-staked validating paymaster is rejected by bundlers, which
# surfaces to a client as a bug in their own code rather than as a misconfigured deployment.
# Note EntryPoint.addStake ADDS to the existing stake rather than setting it, so raising this and
# re-running tops up by the new figure.
STAKE_ETH=0.1
UNSTAKE_DELAY=86400
# Funded per tenant, so the deployer spends this once for EACH entry in PAYMASTER_TENANTS.
TENANT_FUND_ETH=0.02
# Where a tenant withdraws unspent balance to. Defaults to the deployer address.
TENANT_WITHDRAW_ADDRESS=

# ── Tenants ───────────────────────────────────────────────────────────────────────────────
# The tenants to register and fund on the paymaster, as `slug:uuid` pairs. These are the two
# the development environment serves (infra/iac/_locals.tf `tenant_hosts`): `example`, on
# Giano's stock wallet UI, and `byoui`, which hosts its own.
#
# ⚠ The ids are PINNED here and that is load-bearing. The paymaster keys each tenant's balance
# on the 16 bytes of its UUID, so the database and the chain have to agree on it. wallet-api
# says so directly (services/wallet-api/src/services/tenants.ts): a tenant seeded without an
# `id` gets a random one from the database, "and a random id would leave every sponsorship
# refused as unknown tenant". The id is immutable once set — changing it orphans that tenant's
# on-chain balance.
#
# The environment's own TENANTS_SEED must carry these same ids. It does not today:
# deploy/docker-compose.infrastructure.aws.yml seeds both tenants with no `id` field, so
# whatever this registers on chain cannot be matched by that deployment until the seed pins
# them too. Fixing that is a change to the tenants-seed secret, not to this file.
#
# The values are arbitrary but frozen. What matters is only that both sides use the same ones.
PAYMASTER_TENANTS=example:a1000000-0000-4000-8000-000000000001,byoui:a1000000-0000-4000-8000-000000000002

# ==========================================================================================
# B. LOCAL DEMO STACK  (docker-compose.sepolia.yml)
# ==========================================================================================
# Only needed to drive the deployment from a browser. One tenant, on *.localhost. It is
# deliberately the `example` tenant, with the id pinned above, so the local stack and the
# deployed environment agree about at least that tenant rather than inventing a third.

# ── Serving RPC — browser and wallet-api reads ────────────────────────────────────────────
# Separate from DEPLOY_RPC_URL: this one is dialled at runtime by the local stack and must be
# CORS-enabled. A keyless public endpoint is simplest.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain node RPC the self-hosted Alto bundler talks to. Blank reuses RPC_URL, which works
# because the local stack runs Alto with `--safe-mode false` — it validates via eth_call
# simulation rather than debug_traceCall. Point this at a trace-capable endpoint only if you
# enable safe mode. (The deployed environment does run safe mode; that is configured in
# infra/, not here.)
BUNDLER_NODE_RPC_URL=

# ── Bundler keys  (testnet only) ──────────────────────────────────────────────────────────
# Alto's executor: signs and pays gas for every bundle on-chain. Reimbursed from the paymaster
# deposit, but must front the ETH. Needs ~0.05 Sepolia ETH. MUST differ from the deployer.
ALTO_EXECUTOR_PRIVATE_KEY=
# Nonce management / gas price checks. No funding needed. Any throwaway key.
ALTO_UTILITY_PRIVATE_KEY=

# ── The local stack's tenant ──────────────────────────────────────────────────────────────
# Must match one of the PAYMASTER_TENANTS pairs above, or the tenant has no funded balance.
TENANT_SLUG=example
TENANT_ID=a1000000-0000-4000-8000-000000000001

# The wallet origin. Its HOST is the WebAuthn RP ID and is IRREVERSIBLE once passkeys exist.
WALLET_ORIGIN=http://wallet.localhost:8081
RP_ID=wallet.localhost
RP_NAME="Giano Example"
BRAND_NAME="Giano Example"

# The dApp origin(s) allowed to drive the wallet, as a JSON array. Must match EXACTLY where
# you open the dApp — app.localhost:4400 and localhost:4400 are DIFFERENT origins. All three
# loopback forms are listed so the handshake works whichever you use.
GIANO_ALLOWED_DAPP_ORIGINS=["http://app.localhost:4400","http://localhost:4400","http://127.0.0.1:4400"]
# JSON array of origins granted CORS on wallet-api (the thin SDK polls receipts cross-origin).
TENANT_CORS_ORIGINS=["http://app.localhost:4400","http://localhost:4400","http://127.0.0.1:4400"]

OPEN_REGISTRATION=true
# The tenant's admin bearer key, min 16 chars. Authorises the sponsorship-rules step and the
# tenant's ROR endpoints. Singular — ADMIN_API_KEYS (plural) is not read by anything.
ADMIN_API_KEY=sepolia-admin-key-0000
LOG_LEVEL=info
