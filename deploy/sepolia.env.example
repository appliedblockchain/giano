# Giano Sepolia e2e demo — environment.
#   cp deploy/sepolia.env.example deploy/.env   then fill in the values below.
# Defaults target Ethereum Sepolia; change CHAIN_ID + the RPC/address vars to use any EVM chain.
#
# docker compose reads this via --env-file deploy/.env; the deploy + funding helper scripts
# read it too. Never commit deploy/.env — it contains private keys.

# ------------------------------------------------------------------------------------------
# Chain
# ------------------------------------------------------------------------------------------
CHAIN_ID=11155111
# For deploying to a chain other than Sepolia with `--network custom`, also set:
# DEPLOY_CHAIN_ID=11155111

# Canonical ERC-4337 EntryPoint v0.7 (same address on every chain). Override only if your
# chain uses a non-canonical EntryPoint.
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# ------------------------------------------------------------------------------------------
# RPC endpoints
# ------------------------------------------------------------------------------------------
# Browser + wallet-api reads. Must be CORS-enabled and safe to expose to the client.
# A keyless public endpoint is simplest:
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Chain node RPC that the self-hosted Alto bundler talks to. Leave blank to reuse RPC_URL
# (publicnode) — verified to work because the stack runs Alto with --safe-mode false, which
# validates userops via eth_call simulation instead of debug_traceCall. Only set this to a
# trace-capable RPC (e.g. https://eth-sepolia.g.alchemy.com/v2/<KEY>) if you enable safe mode.
BUNDLER_NODE_RPC_URL=

# One-time contract deployment RPC (defaults to RPC_URL if unset). Any Sepolia RPC works.
# DEPLOY_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ------------------------------------------------------------------------------------------
# Keys  (testnet only — never reuse real keys)  ⚠️  FUND THESE, see deploy/sepolia/README.md
# ------------------------------------------------------------------------------------------
# Deploys the contracts and funds the paymaster's EntryPoint deposit. Needs ~0.1 Sepolia ETH.
DEPLOYER_PRIVATE_KEY=

# Alto's executor: signs + pays gas for every bundle on-chain (reimbursed from the paymaster
# deposit, but must front the ETH). Needs ~0.05 Sepolia ETH. MUST differ from the deployer.
ALTO_EXECUTOR_PRIVATE_KEY=
# Alto utility key (nonce management / gas price checks). No funding needed. Any throwaway key.
ALTO_UTILITY_PRIVATE_KEY=

# ------------------------------------------------------------------------------------------
# Contract addresses — filled in automatically by deploy/sepolia/deploy-contracts.sh
# ------------------------------------------------------------------------------------------
FACTORY_ADDRESS=
PAYMASTER_ADDRESS=
TEST_ERC20_ADDRESS=

# How much testnet ETH to seed the paymaster's EntryPoint deposit with, at deploy time.
PAYMASTER_FUND_ETH=0.05

# ------------------------------------------------------------------------------------------
# WebAuthn / origins  (defaults work with the bundled sample dApp on *.localhost)
# ------------------------------------------------------------------------------------------
RP_ID=wallet.localhost
RP_NAME=Giano Sepolia
BRAND_NAME=Giano Sepolia
EXPECTED_ORIGINS=http://wallet.localhost:8081
# The dApp origin(s) allowed to connect. Must match EXACTLY where you open the sample dApp —
# app.localhost:4400 and localhost:4400 are DIFFERENT origins. All three localhost forms are
# listed so the handshake works whichever you use; trim to just your real dApp origin for prod.
CORS_ORIGINS=http://app.localhost:4400,http://localhost:4400,http://127.0.0.1:4400
GIANO_ALLOWED_DAPP_ORIGINS=["http://app.localhost:4400","http://localhost:4400","http://127.0.0.1:4400"]
OPEN_REGISTRATION=true
ADMIN_API_KEYS=sepolia-admin-key
LOG_LEVEL=info
