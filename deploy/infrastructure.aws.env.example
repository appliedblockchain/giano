# ==========================================================================================
# Giano — environment for deploy/docker-compose.infrastructure.aws.yml
#
#   cp deploy/infrastructure.aws.env.example deploy/.env      then fill in the blanks
#   docker compose --env-file deploy/.env -f deploy/docker-compose.infrastructure.aws.yml config
#
# `config` renders the whole stack with interpolation applied and is the fastest way to
# check a JSON-valued variable before anything boots. Never commit deploy/.env — it holds
# private keys. It is covered by the repo's `**/.env` gitignore rule.
#
# ── For the DevOps team: where each value comes from in AWS ───────────────────────────────
#
# Values marked [ASM] are AWS Secrets Manager secrets named `giano-<env>-<key>`, KMS-encrypted
# with the project's customer-managed key and mirrored from ONE 1Password note (§7, §12).
# They reach a container through the task definition's `secrets` block, resolved by the
# EXECUTION role before the container starts — the application only ever sees an ordinary
# environment variable. `valueFrom` is the secret ARN, never the name: Secrets Manager
# appends a random six-character suffix, so a hardcoded name breaks after any recreate.
#
# Values marked [tfvar] are Terraform variables in `infra/iac`, keyed by workspace.
# Values marked [derived] Terraform composes; they are in neither 1Password nor a tfvar.
#
# Two rules from §7.3 worth repeating because they cost real debugging time:
#   * A key not yet filled in is `PLACEHOLDER-DO-NOT-USE`, NEVER an empty string. A service
#     handed an empty RPC URL boots and then fails obscurely on its first chain call.
#   * Editing a value in 1Password without bumping its `version` leaves ASM on the OLD value,
#     silently (R6). It is the first thing to check when a rotation "did not take".
# ==========================================================================================

# ── Images (§11, §15) ─────────────────────────────────────────────────────────────────────
# In AWS: ECR, one repository per image, tagged with the COMMIT SHA and never `latest` —
# repositories are IMMUTABLE, so `latest` will not resolve and the first apply's services
# fail to start by design. GHCR remains the distribution channel.
# Six ECR repositories for seven services — custom-example and custom-example-byoui share
# `example`. All eight images (the six deployed, plus giano-devnet and
# giano-contracts-deployer) are built on every PR and pushed to GHCR by
# .github/workflows/docker.yml; the OIDC ECR push is still outstanding (§16.2).
GIANO_REGISTRY=ghcr.io/appliedblockchain
GIANO_IMAGE_TAG=latest

# ── Hostnames (§2.1, §6) ──────────────────────────────────────────────────────────────────
# Everything about the DNS model follows from one fact: a passkey binds to the hostname in
# the browser's address bar, IRREVERSIBLY. Hence the split below by OWNER.
#
# In AWS these are DNSimple records, all CNAMEs to one ALB that routes by Host header, with
# an ACM wildcard `*.dev.giano.appliedblockchain.dev` covering the one-label names and a
# SEPARATE SNI certificate for each tenant wallet host, which is two labels deep.
#
# URL_SCHEME is `https` in any real deployment. `http` exists only for a loopback run.
URL_SCHEME=https

# Giano's own infrastructure — shared by every tenant, and NEVER a relying party.
API_HOST=api.dev.giano.appliedblockchain.dev
# Routing only: it is the paymaster console's ALB host header, and no container needs to know
# its own hostname, so nothing in the compose file reads this.
PAYMASTER_HOST=paymaster.dev.giano.appliedblockchain.dev
# The shared wallet UI and the CNAME target. NOT an RP ID: no end user ever visits it, and
# no passkey may ever bind to it. Runbook step 10 verifies it returns 404 on
# /.well-known/webauthn. It is not referenced by the compose file for exactly that reason —
# it is listed here because it is part of the deployment.
WALLET_HOST=wallet.dev.giano.appliedblockchain.dev

# Tenant `example` — takes Giano's STOCK wallet UI and reaches it by CNAME.
# Shaped as its own domain with a wallet subdomain underneath, because that is what a real
# client looks like: these stand in for `acme.com` and `wallet.acme.com`.
EXAMPLE_DAPP_HOST=example.dev.giano.appliedblockchain.dev
# ⚠ IRREVERSIBLE (R1). This is the tenant's WebAuthn RP ID. Settle it before the first
# passkey exists; changing it later orphans every credential created against it. This is the
# single choice in the whole deployment that `terraform apply` cannot undo.
EXAMPLE_WALLET_HOST=wallet.example.dev.giano.appliedblockchain.dev
EXAMPLE_BRAND_NAME=Giano Example

# Tenant `byoui` — brings its OWN wallet UI, so it CNAMEs to nothing of Giano's.
# The two tenants are the two ways to BE a tenant, and a deployment serving only one shape
# cannot show that the other works. Cross-tenant isolation is also unobservable with one.
BYOUI_DAPP_HOST=byoui.dev.giano.appliedblockchain.dev
# ⚠ IRREVERSIBLE (R1) — same warning as above.
BYOUI_WALLET_HOST=wallet.byoui.dev.giano.appliedblockchain.dev
BYOUI_BRAND_NAME=Giano Example (BYO UI)

# ── Deployment class ──────────────────────────────────────────────────────────────────────
# What this deployment IS, as distinct from how the image was built (that is NODE_ENV, which
# the image pins to `production` and which should stay there). Required by wallet-api with no
# default, on purpose: it is the single value that decides whether a sponsorship signing key
# may sit in an environment variable.
#
# `testnet` is the honest class for Base Sepolia and is what makes SPONSORSHIP_SIGNER_KIND=
# local legal below. Setting `production` here refuses that combination outright — and the
# `hsm` alternative is not reachable from the published image (R14), so a production-class
# deployment is blocked on that first, not on this variable.
GIANO_DEPLOYMENT_CLASS=testnet

# ── Chain (§13) ───────────────────────────────────────────────────────────────────────────
# [tfvar] var.chain_id / var.chain_name. dev and stg are Base Sepolia; prd is Base (8453).
CHAIN_ID=84532
CHAIN_NAME=Base Sepolia

# [ASM] giano-<env>-rpc-url — an Alchemy (or equivalent) endpoint. The free tier is ample
# for a dev environment. It is a SECRET because the URL embeds the API key.
#
# ⚠ Read the note on wallet-web's GIANO_RPC_URL in the compose file before deploying: the
# same value is used browser-side, where it is published to every visitor. §13.3 accepts
# that (the browser must read chain state directly, and Alchemy sends permissive CORS
# headers) but also describes the better posture — proxy it same-origin and keep the key
# server-side, which the nginx templates already support.
#
# ⚠ ALTO_SAFE_MODE is `true` in this stack because it is a real chain, and safe mode
# validates user operations with `debug_traceCall`. The RPC MUST be trace-capable.
RPC_URL=

# [tfvar] var.rpc_origin — the ORIGIN only, for wallet-web's CSP `connect-src`. Not secret.
RPC_ORIGIN=https://base-sepolia.g.alchemy.com

# [tfvar] EntryPoint v0.7 — canonical at the same address on every chain. Override only for
# a chain with a non-canonical EntryPoint.
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# The GianoSmartWalletFactory. wallet-api and wallet-web both default it correctly from the
# contracts registry for 84532 and should be left unset there — setting them by hand is how
# they drift. It is listed here because the BYO wallet SPA is the exception: its bundle has no
# registry dependency, so e2e/wallet-byo/serve.mjs requires it explicitly. §14.5 states it can
# be left unset, which is true of the other two services but not of that one.
FACTORY_ADDRESS=0x26dCd29390eba3B22BcCbd2143989E5994Ac7050

# ⚠ [tfvar] var.paymaster_address — THE GianoPaymaster PROXY, AND IT MUST BE DEPLOYED FIRST.
# `gianoAddresses[84532]` carries no `sponsorshipPaymaster` and there is no GianoPaymaster in
# `ignition/deployments/chain-84532`, so there is no registry fallback and no default that
# works. Deploying it is a PREREQUISITE of this environment, not part of it (§13.1):
#
#   pnpm --filter @appliedblockchain/giano-contracts hh:deploy:paymaster --network base-sepolia
#   pnpm --filter @appliedblockchain/giano-contracts provision:paymaster -- …
#
# GianoPaymaster takes a `roleAdmin` parameter; in dev that is a developer-held EOA rather
# than a timelock, and whoever holds it is the only person who can change anything through
# the paymaster console. Commit the resulting address to `address-overrides.json` (preferred
# — it makes the address a reviewed artefact) or pass it as a Terraform variable.
PAYMASTER_ADDRESS=

# The label in the paymaster console's header. `<workspace> (<chain name>)` in Terraform.
GIANO_ENVIRONMENT_LABEL=dev (Base Sepolia)

# ── Database (§8) ─────────────────────────────────────────────────────────────────────────
POSTGRES_DB=giano
POSTGRES_USER=giano

# [ASM] giano-<env>-database-password — the RDS master password. In Terraform it is set
# through the write-only `password_wo` argument so the value never reaches the state file,
# and the RDS KMS key CANNOT be changed after creation (R12): re-keying means snapshot,
# copy, restore — an outage and a new endpoint.
POSTGRES_PASSWORD=

# [derived] giano-<env>-database-url. NOT in 1Password: Terraform composes it from the
# ephemeral password and the RDS endpoint, and versions it against the password so bumping
# the password rotates both in one apply (§7.4).
#
# ⚠ The password is `urlencode`d there, and that is not optional: a `#`, `/` or `@` in a DSN
# password silently truncates the connection string, and the failure looks like a wrong
# hostname. Keep that in mind composing one by hand here — and note that leaving it as the
# placeholder is safe: every consumer guards it with `:?`, so compose refuses to render
# rather than starting a service against a half-formed DSN.
DATABASE_URL=postgres://giano:PLACEHOLDER-DO-NOT-USE@postgres:5432/giano

# ── Sponsorship signer (§10.4, D15) ───────────────────────────────────────────────────────
# [ASM] giano-<env>-sponsorship-signer-key — 32-byte hex, `^0x[0-9a-fA-F]{64}$`.
# Signs paymaster data and holds NO funds, so it never needs topping up.
#
# It may live in an environment variable only because GIANO_DEPLOYMENT_CLASS is `testnet`.
# `production` refuses `SPONSORSHIP_SIGNER_KIND=local` outright, and the `hsm` alternative
# needs an HsmSignerAdapter passed to `buildApp` that the published image does not wire
# (R14) — so a production-class deployment is blocked on that first.
SPONSORSHIP_SIGNER_KEY=

# ── Bundler keys (§13.2) ──────────────────────────────────────────────────────────────────
# Both are dev-only keys that must NEVER have held mainnet value.
#
# ⚠ [ASM] giano-<env>-alto-executor-key — MUST BE FUNDED WITH TESTNET ETH, and it drains on
# every sponsored transaction. Together with the paymaster's EntryPoint deposit this is the
# most likely cause of an environment that "stopped working" for no visible reason (R2).
# Nothing alarms on it yet: the Datadog monitor is declared but nothing emits
# `giano.chain.balance` — §16.6 is the fix and is the cheapest item on that list.
ALTO_EXECUTOR_PRIVATE_KEYS=

# [ASM] giano-<env>-alto-utility-key — nonce management and gas-price checks. Needs no
# funding; any throwaway key. Must differ from the executor.
ALTO_UTILITY_PRIVATE_KEY=

# ── Tenant admin keys ─────────────────────────────────────────────────────────────────────
# Min 16 chars each, plaintext in and sha256-hashed at rest. They authorise the tenant's
# admin endpoints, including `PUT /v1/admin/sponsorship` — which is what the
# provision-sponsorship one-shot uses, and why the tenants-seed secret is a secret at all.
# They must be unique across tenants; a shared key is rejected at boot.
#
# `openRegistration` is `true` for both tenants in dev, which is defensible there and only
# there (R4). Turning it off makes these keys mandatory rather than merely used.
EXAMPLE_ADMIN_KEY=
BYOUI_ADMIN_KEY=

# ── Observability ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# [ASM] giano-<env>-metrics-bearer-token — min 16 chars, gates `GET /metrics`. Unset leaves
# the endpoint OPEN, which is acceptable only on a local stack.
METRICS_BEARER_TOKEN=

# In AWS, every task additionally runs a Datadog Agent sidecar and a FireLens log router, and
# both resolve [ASM] giano-<env>-datadog-api-key at runtime. That key is NOT one of Giano's:
# it lives in the shared `DevOps` 1Password vault and Terraform MIRRORS it into Secrets
# Manager for the containers (§7.4). It is the one credential that is both a provider
# credential and a container secret.
#
# ⚠ It has no rotation trigger of its own — bump `var.datadog_api_key_version` when it is
# rotated, or ASM keeps the old key and every task quietly stops reporting (R24).
#
# Neither sidecar is modelled in the compose file, so nothing here configures them.

# ── Published ports (loopback only) ───────────────────────────────────────────────────────
# These exist because compose has no ALB. In AWS there are no published ports at all: one
# load balancer routes by Host header to per-service target groups, no task has a public IP,
# and the bundler has no target group at all.
API_PORT=8080
WALLET_WEB_PORT=8081
PAYMASTER_ADMIN_PORT=8083
EXAMPLE_DAPP_PORT=4400
BYOUI_DAPP_PORT=4401
BYOUI_WALLET_PORT=8082

# ── One-shot job ──────────────────────────────────────────────────────────────────────────
# Set per invocation, not here — one run PER TENANT (`example`, then `byoui`):
#   docker compose … --profile oneshot run --rm -e TENANT_SLUG=example provision-sponsorship
TENANT_SLUG=
