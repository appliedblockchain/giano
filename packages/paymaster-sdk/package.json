{
  "name": "@appliedblockchain/giano-paymaster-sdk",
  "version": "3.0.0",
  "description": "Client library for the Giano sponsorship paymaster: read its whole state and administer it on-chain, with the signer supplied by the caller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appliedblockchain/giano.git",
    "directory": "packages/paymaster-sdk"
  },
  "author": "Applied Blockchain",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "giano-paymaster": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "cli": "tsx cli/index.ts",
    "demo": "tsx demo/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "viem": "^2.31.0"
  },
  "dependencies": {
    "@appliedblockchain/giano-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^9.0.0",
    "tsx": "^4.19.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "viem": "2.31.6",
    "vitest": "^4.1.11"
  }
}
