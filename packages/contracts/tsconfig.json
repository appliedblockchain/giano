{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
  },
  // The package's own TypeScript only: lib/ holds the Solidity submodules, which ship TS of their own.
  "include": ["*.ts", "ignition/**/*.ts", "scripts/**/*.ts"]
}
