# giano-contracts-deployer — one-shot CREATE3 deploy of the canonical contracts from a committed
# release (packages/contracts/deploy/cli.ts), emitting the address registry JSON. Idempotent: a
# contract already at its canonical address is checked and recorded, never redeployed.
#   docker build -f packages/contracts/Dockerfile.deployer -t ghcr.io/appliedblockchain/giano-contracts-deployer .
# Ships as a Helm pre-install hook (deploy/helm/giano, deployer.enabled).
#
# It deploys release creation code (packages/contracts/releases/), so it compiles nothing: no
# forge, no solc, no git submodules.
#
# ABIP-2: every stage on a digest-pinned Docker Hardened Image — -dev to build, the runtime variant to
# run (the wallet-api pins). The CLI is bundled with every dependency into dist-deployer/cli.mjs
# (tsdown.deployer.config.mts), so the runtime holds node, that file, the releases and the CreateX
# deployment data — no node_modules, no tsx, no TypeScript, no shell — and runs as the image's own
# non-root user (node, 1000:1000).

FROM dhi.io/node:22-alpine3.23-dev@sha256:d3e27128c752bc57454dbb824f8ba770ecf211cc8098a471a8fbd68185dd053f AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --filter @appliedblockchain/giano-contracts
COPY packages/contracts packages/contracts
# /out is the record volume: created here because the runtime has no shell to mkdir with, and owned by
# the runtime user so the job can write it without root.
RUN pnpm --filter @appliedblockchain/giano-contracts exec tsdown --config tsdown.deployer.config.mts \
 && mkdir -p /stage/contracts/vendor /out \
 && cp -r packages/contracts/dist-deployer packages/contracts/releases /stage/contracts/ \
 && cp -r packages/contracts/vendor/createx /stage/contracts/vendor/ \
 && mkdir -p /stage/contracts/scripts \
 && cp packages/contracts/scripts/deployer-entrypoint.mjs /stage/contracts/scripts/

FROM dhi.io/node:22-alpine3.23@sha256:920a7460ab7ac19ce6a9a38fb23b244bcfed1cf78705f7fe117195c58b307f4d
WORKDIR /contracts
COPY --from=build --chown=1000:1000 /stage/contracts /contracts
COPY --from=build --chown=1000:1000 /out /out
VOLUME /out
ENTRYPOINT ["node", "/contracts/scripts/deployer-entrypoint.mjs"]
