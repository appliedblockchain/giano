{
	"name": "@appliedblockchain/giano-contracts",
	"version": "6.0.1",
	"description": "Giano smart wallet contracts: ABIs, deployed address registry and Solidity sources",
	"license": "MIT",
	"type": "commonjs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/appliedblockchain/giano.git",
		"directory": "packages/contracts"
	},
	"author": "Applied Blockchain",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src/**/*.sol",
		"vendor/**/*.sol",
		"index.ts",
		"generated.ts",
		"addresses.ts",
		"release-code.ts",
		"release-fingerprints.ts",
		"chains.ts",
		"address-overrides.json",
		"remappings.txt",
		"entrypoint.ts",
		"erc1967.ts",
		"timelock.ts"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"build": "pnpm gen:abis && pnpm gen:addresses && pnpm build:ts",
		"build:ts": "tsdown",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build:ts",
		"compile": "forge build",
		"test": "forge test",
		"coverage": "forge coverage --ir-minimum --no-match-path test/GianoPaymaster/Gas.t.sol --no-match-coverage '(^|/)(test|script|lib|node_modules|vendor|src/testing)/'",
		"coverage:check": "node scripts/check-coverage.mjs",
		"gen:abis": "forge build src --out out-abi --cache-path cache_forge_abi && wagmi generate",
		"gen:releases": "tsx scripts/generate-releases.ts",
		"check:determinism": "tsx scripts/check-determinism.ts",
		"gen:addresses": "tsx scripts/generate-addresses.ts",
		"release:cut": "tsx scripts/release.ts cut",
		"release:verify": "tsx scripts/release.ts verify",
		"release:status": "tsx scripts/release.ts status",
		"deploy:cli": "tsx deploy/cli.ts",
		"local:node": "anvil --enable-trace-printing",
		"local:deploy": "tsx scripts/deploy-local.ts",
		"doctor": "tsx scripts/doctor.ts",
		"provision:paymaster": "tsx scripts/provision-paymaster.ts",
		"storage": "node scripts/storage-layout.mjs",
		"storage:check": "node scripts/storage-layout.mjs --check",
		"test:deploy": "node --import tsx --test deploy/deploy.test.ts deploy/release-code.test.ts deploy/erc1967.test.ts deploy/immutable-checks.test.ts deploy/plan.test.ts deploy/preflight.test.ts deploy/profiles.test.ts deploy/registry.test.ts deploy/operations.test.ts deploy/timelock.test.ts deploy/records.test.ts deploy/doctor-drift.test.ts",
		"test:deploy:integration": "node --import tsx --test deploy/integration.test.ts deploy/overrides.integration.test.ts deploy/secrets.integration.test.ts",
		"test:releases": "node --import tsx --test deploy/release-compile.test.ts",
		"deploy:guided": "node --import tsx deploy/guided.ts",
		"deploy:operate": "node --import tsx deploy/operations.ts"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"viem": "^2.57.10"
	},
	"devDependencies": {
		"@account-abstraction/contracts": "workspace:0.9.0",
		"@openzeppelin/contracts": "5.4.0",
		"@openzeppelin/contracts-upgradeable": "5.4.0",
		"@types/node": "24.19.2",
		"@wagmi/cli": "2.10.0",
		"ethers": "6.13.2",
		"tsdown": "0.23.1",
		"tsx": "4.19.4",
		"typescript": "7.0.2",
		"viem": "2.57.10"
	}
}
