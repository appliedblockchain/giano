{
  "name": "@appliedblockchain/giano-contracts",
  "version": "2.1.0",
  "description": "Giano smart wallet contracts: ABIs, deployed address registry and Solidity sources",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appliedblockchain/giano.git",
    "directory": "packages/contracts"
  },
  "author": "Applied Blockchain",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/**/*.sol",
    "index.ts",
    "generated.ts",
    "addresses.ts",
    "address-overrides.json",
    "remappings.txt"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "pnpm hh:compile && pnpm hh:wagmi && pnpm gen:addresses && pnpm build:ts",
    "build:ts": "tsup",
    "prepublishOnly": "pnpm build:ts",
    "gen:addresses": "ts-node scripts/generate-addresses.ts",
    "doctor": "ts-node scripts/doctor.ts",
    "hh:node": "anvil --enable-trace-printing",
    "hh:deploy": "hardhat ignition deploy ignition/modules/GianoAccountFactory.ts --strategy create2",
    "hh:deploy:mapper": "hardhat ignition deploy ignition/modules/index.ts --strategy create2",
    "hh:deploy:testing": "hardhat ignition deploy ignition/modules/Testing.ts --strategy create2",
    "hh:deploy:paymaster": "hardhat ignition deploy ignition/modules/GianoPaymaster.ts --strategy create2",
    "provision:paymaster": "ts-node scripts/provision-paymaster.ts",
    "storage": "node scripts/storage-layout.mjs",
    "storage:check": "node scripts/storage-layout.mjs --check",
    "hh:localwipe": "rm -rf ignition/deployments/chain-31337",
    "hh:initlocal": "pnpm hh:localwipe && pnpm build && pnpm -w aa:deploy:local && pnpm hh:deploy --network localhost && pnpm hh:deploy:testing --network localhost",
    "hh:compile": "hardhat compile",
    "hh:clean": "hardhat clean",
    "hh:wagmi": "wagmi generate"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@nomicfoundation/ethereumjs-util": "^9.0.4",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-foundry": "^1.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.7",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.7",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.6",
    "@nomicfoundation/ignition-core": "^0.15.1",
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0",
    "@peculiar/asn1-ecc": "^2.3.14",
    "@peculiar/asn1-schema": "^2.3.13",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.7.5",
    "@wagmi/cli": "^2.2.1",
    "chai": "^4.3.10",
    "dotenv": "^16.5.0",
    "ethers": "6.13.2",
    "hardhat": "2.22.10",
    "hardhat-gas-reporter": "^1.0.9",
    "hardhat-tracer": "^3.1.0",
    "mocha": "^10.7.3",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.1",
    "tsup": "^8.3.5",
    "typechain": "^8.3.2",
    "typescript": "5.5.4"
  }
}
