{
  "name": "@appliedblockchain/giano-wallet-transport",
  "version": "0.1.0",
  "description": "JSON-RPC-over-postMessage popup transport between dApps and the Giano wallet origin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appliedblockchain/giano.git",
    "directory": "packages/wallet-transport"
  },
  "author": "Applied Blockchain",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "ulid": "^3.0.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "happy-dom": "^17.4.4",
    "tsup": "^8.3.5",
    "typescript": "5.5.4",
    "vitest": "^3.1.2"
  }
}
